{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ 1-Click Launch Dashboard (F5)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_dashboard.py",
            "console": "integratedTerminal"
        },
        {
            "name": "▶ Run Streamlit Directly",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboard/app.py",
                "--server.headless=true"
            ],
            "console": "integratedTerminal"
        }
    ]
}
